<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FOURNISSEUR</title>
</head>
<body>
    <div class="container">
        <form action="/api/fournisseur" method="post">

            <label for="nomFournisseur">Nom : </label>
            <input type="text" id="nomFournisseur" name="nom" placeholder="Nom du fournisseur">

            <label for="responsableFournisseur">Responsable : </label>
            <input type="text" id="responsableFournisseur" name="responsable" placeholder="Nom du Responsable à contacter">

            <label for="emailFournisseur">Mail : </label>
            <input type="email" id="responsableFournisseur" name="mail" placeholder="Mail du fournisseur">

            <label for="telephoneFournisseur">Téléphone : </label>
            <input type="text" id="telephoneFournisseur" name="telephone" placeholder="Téléphone du fournisseur">

            <label for="adresseFournisseur">Adresse Postale : </label>
            <input type="text" id="adresseFournisseur" name="adresse" placeholder="Adresse Postale du fournisseur">

            <label for="presentationFournisseur">Présentation : </label>
            <textarea id="presentationFournisseur" name="Presentation" placeholder="Dites-nous plus sur le fournisseur" style="height: 200px"></textarea>

            <input type="submit" value="Enregistrer">

        </form>
    </div>
</body>
</html>