<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mon Équipe</title>

    <link rel="stylesheet" href="/css/style2.css">
    <link rel="stylesheet" href="/css/modal.css">
    <link rel="stylesheet" href="/css/toast.css">

    <script src="/js/modal.js" defer></script>
    <script src="/js/script.js" defer></script>
</head>
<body>

    <%- include('navbar') -%>

    <h2>Mon Équipe May Gourmet</h2>

    <div class="cards">
        <% resultatEquipe.forEach(resultat => { %>
            <div class="card">
                <img class="boule" src="/images/full hd.avif" alt="Avatar">
                <div class="container">
                    <h1><b><%= resultat.nom %> <%= resultat.prenom %></b></h1>
                    <p><%= resultat.poste %></p>

                    <input type="button" value="Supprimer" onclick="supprimer('<%= resultat.id %>')">
                    
                    <input type="button" value="Modifier" onclick="modifier(
                        '<%= resultat.id %>',
                        '<%= resultat.nom %>',
                        '<%= resultat.prenom %>',
                        '<%= resultat.email %>',
                        '<%= resultat.telephone %>',
                        '<%= resultat.poste %>',
                        '<%= resultat.adresse_postale %>',
                        '<%= resultat.presentation %>',
                        '<%= resultat.date_recrutement %>'
                    )">
                </div>
            </div>
        <% }) %>
    </div>

    <!-- Toast -->
    <div id="toast" class="toast"></div>

    <!-- Bouton ouverture modal -->
    <button id="myBtn">Ajouter un membre</button>

    <!-- MODAL -->
    <div id="myModal" class="modal">
        <div class="modal-content">
            <span class="close">&times;</span>

            <div class="modal-body">
                <p class="modal-header">Ajouter un membre</p>

                <form id="membreForm" action="/api/equipe" method="post">

                    <div class="row">
                        <label>Nom :</label>
                        <input type="text" id="nom" name="nom">
                    </div>

                    <div class="row">
                        <label>Prénom :</label>
                        <input type="text" id="prenom" name="prenom">
                    </div>

                    <div class="row">
                        <label>Email :</label>
                        <input type="email" id="email" name="email">
                    </div>

                    <div class="row">
                        <label>Téléphone :</label>
                        <input type="text" id="telephone" name="telephone">
                    </div>

                    <div class="row">
                        <label>Poste :</label>
                        <input type="text" id="poste" name="poste">
                    </div>

                    <div class="row">
                        <label>Adresse Postale :</label>
                        <input type="text" id="adresse_postale" name="adresse_postale">
                    </div>

                    <div class="row">
                        <label>Présentation :</label>
                        <textarea id="presentation" name="presentation" rows="4"></textarea>
                    </div>

                    <div class="row">
                        <label>Date de recrutement :</label>
                        <input type="date" id="dateRecrutement" name="date_recrutement">
                    </div>

                    <div class="modal-footer">
                        <button type="submit">Enregistrer</button>
                    </div>

                </form>
            </div>

        </div>
    </div>

</body>
</html>